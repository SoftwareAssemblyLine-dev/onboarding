{
  "name": "login-app",
  "version": "1.0.0",
  "description": "A login and user registration application built with Node.js and Express.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node --loader ts-node/esm\" source/server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:end2end": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.js --runInBand",
    "test:gui": "playwright test",
    "test:gui:ui": "playwright test --ui",
    "lint": "eslint source/ --ext .ts",
    "lint:fix": "eslint source/ --ext .ts --fix",
    "format": "eslint --fix source/",
    "format:check": "eslint source/",
    "format:all": "npm run format && npm run lint:fix",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "prepare": "husky"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "mjs"
    ],
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/source"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/source/end2end/gui/"
    ],
    "collectCoverageFrom": [
      "source/**/*.ts",
      "!source/end2end/**/*.ts",
      "!source/server.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -lc 'tsc --noEmit --project tsconfig.json'"
    ]
  },
  "keywords": [],
  "author": "Leo",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
}
